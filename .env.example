# Copie para .env.local e preencha. O .env.local nao vai para o git.

# Endpoint do servico de voz local do Zeus (motor gratuito, no servidor).
# Em producao, atras do mesmo dominio para evitar CORS.
VITE_ZEUS_TTS_ENDPOINT=/api/voz

# Endereco do cerebro do Zeus (servidor/zeus.js, na mesma VPS).
VITE_ZEUS_ENDPOINT=/api/zeus

# Tapa-buraco de porta: viaja para o navegador e qualquer um le no codigo da
# pagina. NAO e seguranca — quem segura o prejuizo e o teto diario do
# servidor (ZEUS_LIMITE_DIA). Precisa ser igual ao ZEUS_TOKEN da VPS.
VITE_ZEUS_TOKEN=
